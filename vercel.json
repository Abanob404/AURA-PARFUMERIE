{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.{png,webp,svg,ico,jpg,jpeg}",
      "use": "@vercel/static"
    },
    {
      "src": "*.json",
      "use": "@vercel/static"
    },
    {
      "src": "fonts/**",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/products_page",
      "destination": "/products",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/server/index"
    },
    {
      "source": "/p/:path*",
      "destination": "/server/index"
    },
    {
      "source": "/robots.txt",
      "destination": "/server/index"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/server/index"
    },
    {
      "source": "/privacy",
      "destination": "/server/index"
    },
    {
      "source": "/shipping-policy",
      "destination": "/server/index"
    },
    {
      "source": "/returns-policy",
      "destination": "/server/index"
    },
    {
      "source": "/authenticity",
      "destination": "/server/index"
    },
    {
      "source": "/warranty",
      "destination": "/server/index"
    },
    {
      "source": "/terms",
      "destination": "/server/index"
    },
    {
      "source": "/facebook",
      "destination": "/server/index"
    },
    {
      "source": "/facebook-:path*",
      "destination": "/server/index"
    },
    {
      "source": "/instagram",
      "destination": "/server/index"
    },
    {
      "source": "/instagram-:path*",
      "destination": "/server/index"
    },
    {
      "source": "/whatsapp",
      "destination": "/server/index"
    },
    {
      "source": "/whatsapp-:path*",
      "destination": "/server/index"
    },
    {
      "source": "/tiktok",
      "destination": "/server/index"
    },
    {
      "source": "/tiktok-:path*",
      "destination": "/server/index"
    },
    {
      "source": "/telegram",
      "destination": "/server/index"
    },
    {
      "source": "/telegram-:path*",
      "destination": "/server/index"
    },
    {
      "source": "/youtube",
      "destination": "/server/index"
    },
    {
      "source": "/youtube-:path*",
      "destination": "/server/index"
    },
    {
      "source": "/qr",
      "destination": "/server/index"
    },
    {
      "source": "/qr-:path*",
      "destination": "/server/index"
    },
    {
      "source": "/campaign-:path*",
      "destination": "/server/index"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/products",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/services",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/p/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:path*.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:path*.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 2 * * *"
    }
  ]
}
